<a href="/categorias" class="inline-block mb-4 text-sm text-slate-500 hover:text-slate-700 transition">← Volver a categorías</a>

<h1 class="text-2xl font-bold text-slate-900 mb-6">
  <%= modo === 'editar' ? 'Editar categoría' : 'Nueva categoría' %>
</h1>

<div class="max-w-xl bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">

  <% /* Errores de validación devueltos por el controlador */ %>
  <% if (errores.length > 0) { %>
    <div class="mb-5 px-4 py-3 rounded-xl bg-red-50 border border-red-200">
      <p class="text-sm font-semibold text-red-700 mb-1">Revisa los siguientes errores:</p>
      <ul class="list-disc list-inside text-sm text-red-600">
        <% errores.forEach(function(error) { %>
          <li><%= error %></li>
        <% }); %>
      </ul>
    </div>
  <% } %>

  <!-- En edición se usa PUT vía method-override; en creación, POST normal -->
  <form action="<%= modo === 'editar' ? '/categorias/' + categoria._id + '?_method=PUT' : '/categorias' %>"
        method="POST" class="space-y-5">

    <!-- Nombre (obligatorio y único) -->
    <div>
      <label for="nombre" class="block text-sm font-semibold text-slate-700 mb-1">
        Nombre <span class="text-red-500">*</span>
      </label>
      <input type="text" id="nombre" name="nombre" maxlength="80" required
             value="<%= datos.nombre %>"
             placeholder="Ej: Personal"
             class="w-full px-3 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition">
    </div>

    <!-- Descripción (opcional) -->
    <div>
      <label for="descripcion" class="block text-sm font-semibold text-slate-700 mb-1">Descripción</label>
      <textarea id="descripcion" name="descripcion" rows="3" maxlength="300"
                placeholder="Descripción de la categoría (opcional)"
                class="w-full px-3 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition"><%= datos.descripcion %></textarea>
    </div>

    <!-- Botones -->
    <div class="flex items-center gap-3 pt-2">
      <button type="submit"
              class="px-5 py-2.5 rounded-lg bg-blue-600 text-white font-semibold hover:bg-blue-700 transition shadow-sm">
        <%= modo === 'editar' ? 'Guardar cambios' : 'Crear categoría' %>
      </button>
      <a href="/categorias" class="text-sm text-slate-500 hover:text-slate-700 transition">Cancelar</a>
    </div>
  </form>
</div>
