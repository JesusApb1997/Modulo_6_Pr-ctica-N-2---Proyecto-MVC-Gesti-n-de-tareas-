<a href="/categorias" class="inline-block mb-4 text-sm text-slate-500 hover:text-slate-700 transition">← Volver al listado</a>

<h1 class="text-2xl font-bold text-slate-900 mb-6">Categorías</h1>

<%- include('../partials/mensajes') %>

<div class="max-w-2xl space-y-3">

  <% if (categorias.length === 0) { %>
    <div class="bg-white border border-dashed border-slate-300 rounded-2xl p-10 text-center">
      <p class="text-4xl mb-3">🗂️</p>
      <p class="font-semibold text-slate-700">No hay categorías</p>
      <p class="text-sm text-slate-500 mb-4">Crea la primera categoría para poder asignar tareas.</p>
      <a href="/categorias/nueva"
         class="inline-block px-4 py-2 rounded-lg bg-blue-600 text-white text-sm font-semibold hover:bg-blue-700 transition">
        + Crear categoría
      </a>
    </div>
  <% } else { %>
    <% categorias.forEach(function(categoria) { %>
      <article class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 class="font-semibold text-slate-900"><%= categoria.nombre %></h2>
          <% if (categoria.descripcion) { %>
            <p class="text-sm text-slate-600"><%= categoria.descripcion %></p>
          <% } %>
        </div>

        <div class="flex items-center gap-2">
          <a href="/categorias/<%= categoria._id %>/editar"
             class="text-xs font-semibold px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200 transition">
            ✎ Editar
          </a>
          <form action="/categorias/<%= categoria._id %>?_method=DELETE" method="POST" class="m-0"
                onsubmit="return confirm('¿Eliminar esta categoría?');">
            <button type="submit"
                    class="text-xs font-semibold px-3 py-1.5 rounded-lg bg-red-100 text-red-700 hover:bg-red-200 transition">
              🗑 Eliminar
            </button>
          </form>
        </div>
      </article>
    <% }); %>

    <a href="/categorias/nueva"
       class="inline-block mt-2 px-4 py-2 rounded-lg bg-blue-600 text-white text-sm font-semibold hover:bg-blue-700 transition">
      + Nueva categoría
    </a>
  <% } %>
</div>
