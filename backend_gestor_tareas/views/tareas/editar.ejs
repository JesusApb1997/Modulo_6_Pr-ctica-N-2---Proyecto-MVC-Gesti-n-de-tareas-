<a href="/tareas" class="inline-block mb-4 text-sm text-slate-500 hover:text-slate-700 transition">← Volver al listado</a>

<h1 class="text-2xl font-bold text-slate-900 mb-6">Editar tarea</h1>

<div class="max-w-xl bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">

  <% /* Errores de validación devueltos por el controlador */ %>
  <% if (errores.length > 0) { %>
    <div class="mb-5 px-4 py-3 rounded-xl bg-red-50 border border-red-200">
      <p class="text-sm font-semibold text-red-700 mb-1">Revisa los siguientes errores:</p>
      <ul class="list-disc list-inside text-sm text-red-600">
        <% errores.forEach(function(error) { %>
          <li><%= error %></li>
        <% }); %>
      </ul>
    </div>
  <% } %>

  <!-- PUT vía method-override -->
  <form action="/tareas/<%= tarea._id %>?_method=PUT" method="POST" class="space-y-5">

    <!-- Título (obligatorio) -->
    <div>
      <label for="titulo" class="block text-sm font-semibold text-slate-700 mb-1">
        Título <span class="text-red-500">*</span>
      </label>
      <input type="text" id="titulo" name="titulo" maxlength="150" required
             value="<%= datos.titulo %>"
             class="w-full px-3 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition">
    </div>

    <!-- Descripción -->
    <div>
      <label for="descripcion" class="block text-sm font-semibold text-slate-700 mb-1">Descripción</label>
      <textarea id="descripcion" name="descripcion" rows="3" maxlength="500"
                class="w-full px-3 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition"><%= datos.descripcion %></textarea>
    </div>

    <!-- Categoría (obligatoria) -->
    <div>
      <label for="categoria" class="block text-sm font-semibold text-slate-700 mb-1">
        Categoría <span class="text-red-500">*</span>
      </label>
      <select id="categoria" name="categoria" required
              class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition">
        <option value="" disabled <%= datos.categoria === '' ? 'selected' : '' %>>Selecciona una categoría…</option>
        <% categorias.forEach(function(categoria) { %>
          <option value="<%= categoria._id %>" <%= datos.categoria === String(categoria._id) ? 'selected' : '' %>>
            <%= categoria.nombre %>
          </option>
        <% }); %>
      </select>
    </div>

    <!-- Estado actual -->
    <p class="text-xs text-slate-500">
      Estado: <strong><%= tarea.completado ? 'Completada' : 'Pendiente' %></strong> ·
      Creada: <%= new Date(tarea.fechaCreacion).toLocaleDateString('es') %>
    </p>

    <!-- Botones -->
    <div class="flex items-center gap-3 pt-2">
      <button type="submit"
              class="px-5 py-2.5 rounded-lg bg-blue-600 text-white font-semibold hover:bg-blue-700 transition shadow-sm">
        Guardar cambios
      </button>
      <a href="/tareas" class="text-sm text-slate-500 hover:text-slate-700 transition">Cancelar</a>
    </div>
  </form>
</div>
