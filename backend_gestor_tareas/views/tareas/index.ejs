<%- include('../partials/mensajes') %>

<div class="flex flex-wrap items-center justify-between gap-3 mb-6">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">
      <% if (typeof categoriaActual !== 'undefined' && categoriaActual) { %>
        Categoría: <%= categoriaActual.nombre %>
      <% } else if (filtroActual === 'completas') { %>
        Tareas completas
      <% } else if (filtroActual === 'incompletas') { %>
        Tareas pendientes
      <% } else { %>
        Todas las tareas
      <% } %>
    </h1>
    <p class="text-sm text-slate-500"><%= tareas.length %> tarea(s) encontrada(s)</p>
  </div>
</div>

<div class="grid lg:grid-cols-[1fr_260px] gap-8">

  <!-- ============ LISTADO DE TAREAS ============ -->
  <section>
    <% if (tareas.length === 0) { %>
      <div class="bg-white border border-dashed border-slate-300 rounded-2xl p-10 text-center">
        <p class="text-4xl mb-3">📝</p>
        <p class="font-semibold text-slate-700">No hay tareas para mostrar</p>
        <p class="text-sm text-slate-500 mb-4">Crea tu primera tarea para comenzar.</p>
        <a href="/tareas/nueva"
           class="inline-block px-4 py-2 rounded-lg bg-blue-600 text-white text-sm font-semibold hover:bg-blue-700 transition">
          + Crear tarea
        </a>
      </div>
    <% } else { %>
      <div class="grid sm:grid-cols-2 xl:grid-cols-3 gap-4">
        <% tareas.forEach(function(tarea) { %>
          <article class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm hover:shadow-md transition flex flex-col gap-3
                          <%= tarea.completado ? 'opacity-75' : '' %>">
            <div class="flex items-start justify-between gap-2">
              <h2 class="font-semibold text-slate-900 leading-snug <%= tarea.completado ? 'line-through text-slate-400' : '' %>">
                <%= tarea.titulo %>
              </h2>
              <span class="shrink-0 text-[11px] font-bold px-2 py-0.5 rounded-full
                           <%= tarea.completado ? 'bg-green-100 text-green-700' : 'bg-amber-100 text-amber-700' %>">
                <%= tarea.completado ? 'Completada' : 'Pendiente' %>
              </span>
            </div>

            <% if (tarea.descripcion) { %>
              <p class="text-sm text-slate-600"><%= tarea.descripcion %></p>
            <% } %>

            <% if (tarea.categoria) { %>
              <p class="text-xs text-slate-500">
                🗂️ <%= tarea.categoria.nombre %>
              </p>
            <% } %>

            <p class="text-xs text-slate-400">Creada: <%= new Date(tarea.fechaCreacion).toLocaleDateString('es') %></p>

            <!-- Acciones de la tarjeta -->
            <div class="mt-auto pt-2 flex flex-wrap gap-2">
              <% if (!tarea.completado) { %>
                <form action="/tareas/<%= tarea._id %>/completar?_method=PATCH" method="POST" class="m-0">
                  <button type="submit"
                          class="text-xs font-semibold px-3 py-1.5 rounded-lg bg-green-100 text-green-700 hover:bg-green-200 transition">
                    ✓ Completar
                  </button>
                </form>
              <% } %>
              <a href="/tareas/<%= tarea._id %>/editar"
                 class="text-xs font-semibold px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200 transition">
                ✎ Editar
              </a>
              <form action="/tareas/<%= tarea._id %>?_method=DELETE" method="POST" class="m-0"
                    onsubmit="return confirm('¿Eliminar esta tarea?');">
                <button type="submit"
                        class="text-xs font-semibold px-3 py-1.5 rounded-lg bg-red-100 text-red-700 hover:bg-red-200 transition">
                  🗑 Eliminar
                </button>
              </form>
            </div>
          </article>
        <% }); %>
      </div>
    <% } %>
  </section>

  <!-- ============ SIDEBAR: FILTRO POR CATEGORÍA ============ -->
  <aside class="space-y-2">
    <h2 class="text-sm font-bold text-slate-500 uppercase tracking-wide mb-2">Filtrar por categoría</h2>

    <a href="/tareas"
       class="block px-3 py-2 rounded-lg text-sm font-medium transition
              <%= (typeof categoriaActual === 'undefined' || !categoriaActual) ? 'bg-blue-50 text-blue-700' : 'bg-white text-slate-700 hover:bg-slate-100' %> border border-slate-200">
      Todas las categorías
    </a>

    <% categorias.forEach(function(categoria) { %>
      <a href="/tareas/categoria/<%= categoria._id %>"
         class="block px-3 py-2 rounded-lg text-sm font-medium transition border
                <%= (typeof categoriaActual !== 'undefined' && categoriaActual && String(categoriaActual._id) === String(categoria._id))
                     ? 'bg-blue-50 text-blue-700 border-blue-200'
                     : 'bg-white text-slate-700 hover:bg-slate-100 border-slate-200' %>">
        <%= categoria.nombre %>
      </a>
    <% }); %>

    <% if (categorias.length === 0) { %>
      <p class="text-xs text-slate-400 px-1">
        Aún no hay categorías.
        <a href="/categorias/nueva" class="text-blue-600 hover:underline">Crear una</a>
      </p>
    <% } %>
  </aside>
</div>
